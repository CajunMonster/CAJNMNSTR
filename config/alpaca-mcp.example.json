{
  "mcpServers": {
    "alpaca-market-readonly": {
      "command": "uvx",
      "args": ["--with", "fastmcp==3.1.0", "alpaca-mcp-server==2.3.0"],
      "env": {
        "ALPACA_API_KEY": "SET_ONLY_IN_YOUR_LOCAL_MCP_CLIENT",
        "ALPACA_SECRET_KEY": "SET_ONLY_IN_YOUR_LOCAL_MCP_CLIENT",
        "ALPACA_PAPER_TRADE": "true",
        "ALPACA_TOOLSETS": "assets,stock-data,options-data,news"
      }
    }
  }
}
