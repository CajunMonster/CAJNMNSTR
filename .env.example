# Copy this file to .env.local and fill it in only on this computer.
# .env.local is ignored by Git. Never paste its contents into chat.

CAJNMNSTR_ENV=paper
CAJNMNSTR_DATA_ROOT=F:\CAJNMNSTR
CAJNMNSTR_RUNTIME_ROOT=runtime
CAJNMNSTR_EXECUTION_ENABLED=false
CAJNMNSTR_EXECUTION_CONFIRMATION=

ALPACA_API_BASE_URL=https://paper-api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_STOCK_FEED=iex
ALPACA_OPTIONS_FEED=indicative
ALPACA_DATA_ENTITLEMENT=unknown

CAJNMNSTR_AI_PROVIDER=openai
OPENAI_API_KEY=
CAJNMNSTR_TERRA_MODEL=gpt-5.6-terra
CAJNMNSTR_AI_TIMEOUT_SECONDS=30
