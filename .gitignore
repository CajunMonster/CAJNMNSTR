# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local credentials and runtime state
.env*
!.env.example
/.venv/
/runtime/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
